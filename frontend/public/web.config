<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the built app (dist). Requires the IIS URL Rewrite module:
  https://www.iis.net/downloads/microsoft/url-rewrite
  and Application Request Routing (ARR) with its proxy turned on, for the APIs:
  https://www.iis.net/downloads/microsoft/application-request-routing
  Host dist as a site root, e.g. http://server/ or http://server:8080/ (not as a sub-application).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- All data comes from the APIs behind Insights.Gateway. Change the address if it runs elsewhere.
             (Or skip IIS: the gateway can serve this folder itself; see Gateway:UiPath.) -->
        <rule name="API gateway" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5000/api/{R:1}" />
        </rule>
        <!-- Sample data (*.data.json) is input to the offline documentation process only. -->
        <rule name="Block sample data" stopProcessing="true">
          <match url="\.data\.json$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found" />
        </rule>
        <!-- The app routes in the browser: paths that are not files (/table-details, /relationships)
             get index.html. Missing files with an extension still 404, which the app reads as
             "file not published". -->
        <rule name="SPA routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="\.[A-Za-z0-9]+$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- IIS only serves extensions it knows. remove/add avoids duplicate errors where one exists.
         No "; charset" parameter: IIS matches it against the request's Accept header and answers
         406 when they differ. The app reads catalog files as UTF-8 either way. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- index.html is revalidated, so a new build shows on refresh. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <security>
      <requestFiltering>
        <!-- The Node launcher files packaged beside the app are not part of the site. -->
        <hiddenSegments>
          <add segment="serve.mjs" />
          <add segment="start.cmd" />
          <add segment="start.sh" />
          <add segment="README.txt" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Hashed build files never change; cache them for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
