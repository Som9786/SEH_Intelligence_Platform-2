{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  // The one address the UI and other clients use. DB Guide, Analytics and AI Hub listen on localhost only.
  "Urls": "http://localhost:5000",
  // Each user's schedules, widgets and shared insights, and the table reviews, kept by the gateway as JSON files.
  "Workspace": {
    // Relative to this project, or absolute.
    "DataPath": "App_Data",
    // How many days a shared insight's link works.
    "ShareDays": 30
  },
  "Gateway": {
    // POST /api/ai/ask waits this long for Analytics or DB Guide to answer (two model calls and a query, so minutes).
    "AskTimeoutSeconds": 300,
    // The built UI (npm run build in SEH Intelligence Platform), served at the site root. Relative to this project,
    // or absolute. When the folder doesn't exist the gateway serves the API only, as in development.
    "UiPath": "../../../SEH Intelligence Platform/dist",
    // Who can sign in, and their roles. FOR NOW the password is plain text here: anyone who can read this file can
    // sign in. Before going live, move users to a real identity provider (or at least keep passwords out of the repo,
    // in user-secrets or environment variables, e.g. Gateway__Users__0__Password).
    "Users": [
      { "Username": "Admin", "Password": "Demo@123", "Roles": [ "Admin" ] }
    ],
    // What each role can use: the UI's functionalities (its pages). The UI shows only these, and the API routes below
    // answer only for them. A user gets the functionalities of all their roles.
    "Roles": {
      "Admin": [
        "overview",
        "insights-assistant",
        "db-catalog",
        "scheduled-insights",
        "basket-intelligence",
        "fresh-food-forecasting",
        "revenue-opportunities"
      ],
      // An example of a narrower role; no user has it yet.
      "Viewer": [ "overview", "db-catalog" ]
    },
    // What each service may be asked from outside, as "METHOD path" under /api/<service>/ (a trailing * matches the
    // rest of the path), and the functionalities that may ask it ("*" for anyone signed in). Everything else stays
    // internal: raw SQL, logs, reloads, editing examples, reading everyone's feedback, and AI Hub's model calls (only
    // Analytics and DB Guide call those, directly).
    "Allow": {
      "db-guide": {
        "GET catalog/files/*": "db-catalog",
        "GET catalog": "db-catalog",
        "GET catalog/tables/*": "db-catalog",
        "GET catalog/status": "db-catalog",
        "GET guide": "db-catalog, insights-assistant",
        "GET health": "*",
        "POST ask": "db-catalog, insights-assistant",
        "POST context": "db-catalog, insights-assistant"
      },
      "analytics": {
        "GET health": "*",
        "GET schema": "insights-assistant, basket-intelligence",
        "GET dataset": "insights-assistant, basket-intelligence",
        "GET examples": "insights-assistant, basket-intelligence",
        "GET knowledge-model/status": "insights-assistant, basket-intelligence",
        "POST ask": "insights-assistant, basket-intelligence",
        "POST context": "insights-assistant, basket-intelligence",
        "POST feedback": "insights-assistant, basket-intelligence"
      },
      "ai": {
        "GET health": "*",
        "GET usage": "*",
        // One question in: the gateway asks AI Hub whether it's about the data or the database, then asks Analytics or DB Guide.
        "POST ask": "insights-assistant",
        "POST intent": "insights-assistant",
        "POST follow-ups": "insights-assistant"
      },
      // Each user's schedules and board widgets, kept by the gateway itself (Workspace/) for the signed-in user.
      "workspace": {
        "GET health": "*",
        "GET schedules": "scheduled-insights",
        "POST schedules": "insights-assistant, scheduled-insights",
        "PUT schedules/*": "scheduled-insights",
        "DELETE schedules/*": "scheduled-insights",
        "GET widgets": "basket-intelligence, fresh-food-forecasting, revenue-opportunities",
        "GET widgets/*": "basket-intelligence, fresh-food-forecasting, revenue-opportunities",
        "POST widgets": "insights-assistant",
        // Shared insights: a board's user shares a copy of a widget; anyone signed in opens it by its link.
        "POST shares": "basket-intelligence, fresh-food-forecasting, revenue-opportunities",
        "GET shares/*": "*",
        "PUT widgets/*": "basket-intelligence, fresh-food-forecasting, revenue-opportunities",
        "DELETE widgets/*": "basket-intelligence, fresh-food-forecasting, revenue-opportunities",
        // Table reviews on DB Catalog: shared by everyone; the reviewer is the signed-in user.
        "GET reviews": "db-catalog",
        "GET reviews/*": "db-catalog",
        "PUT reviews/*": "db-catalog"
      }
    }
  },
  // /api/<service>/... is passed on to the service without the /api/<service> prefix, and without the sign-in cookie,
  // which is the gateway's alone.
  "ReverseProxy": {
    "Routes": {
      "db-guide": {
        "ClusterId": "db-guide",
        "Match": { "Path": "/api/db-guide/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/db-guide" }, { "RequestHeaderRemove": "Cookie" } ]
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/analytics" }, { "RequestHeaderRemove": "Cookie" } ]
      },
      "ai": {
        "ClusterId": "ai",
        "Match": { "Path": "/api/ai/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/ai" }, { "RequestHeaderRemove": "Cookie" } ]
      }
    },
    // An answer can take minutes (two model calls and a query), so the proxy waits a little longer than
    // Gateway:AskTimeoutSeconds; otherwise it would give up (504) on an answer already being paid for. YARP's default is 100 s.
    // These addresses are also where the gateway itself calls the services (Ask/).
    "Clusters": {
      "db-guide": { "HttpRequest": { "ActivityTimeout": "00:05:30" }, "Destinations": { "local": { "Address": "http://localhost:5300/" } } },
      "analytics": { "HttpRequest": { "ActivityTimeout": "00:05:30" }, "Destinations": { "local": { "Address": "http://localhost:5100/" } } },
      "ai": { "HttpRequest": { "ActivityTimeout": "00:05:30" }, "Destinations": { "local": { "Address": "http://localhost:5200/" } } }
    }
  }
}
