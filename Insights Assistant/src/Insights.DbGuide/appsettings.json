{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5300",
  "Neo4j": {
    "Uri": "neo4j://127.0.0.1:7687",
    "User": "neo4j",
    "Password": "",
    "Database": "db-guide"
  },
  "Catalog": {
    // The database catalog export (database.json, business-areas.json, relationships.json, tables/*.json and
    // documentation/*.md), relative to this project. Reloaded into Neo4j when a file in it changes.
    "Path": "catalog"
  },
  "Workspace": {
    // Where each user's schedules and widgets, the shared insights and the table reviews are kept, as JSON files.
    // Relative to this project, or absolute.
    "DataPath": "App_Data",
    // How many days a shared insight's link works.
    "ShareDays": 30
  },
  "AiHub": {
    "BaseUrl": "http://localhost:5200",
    "TimeoutSeconds": 180
  },
  "DebugLog": {
    "Enabled": false,
    "MaxEntries": 1000,
    "WriteToFile": true,
    "FileDirectory": "logs",
    "RetainedFileDays": 7
  }
}
