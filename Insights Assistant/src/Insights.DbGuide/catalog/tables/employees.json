  "businessRules": [
    { "text": "Every employee belongs to an existing department and has a first name, last name and email address, and no two employees share an email address.", "evidence": "confirmed" },
    { "text": "New employees are active and hired today (UTC) unless other values are given.", "evidence": "confirmed" },
    { "text": "Every update or deletion of an employee is logged in dbo.AuditLog; inserts are not.", "evidence": "confirmed" },
    { "text": "A line manager should be an existing employee and a sales representative on an order should be an employee, but the database enforces neither.", "evidence": "inferred" },
    { "text": "Leavers appear to be marked inactive rather than deleted, which keeps their orders and reports linked to them.", "evidence": "inferred" }
