  "businessRules": [
    { "text": "Every product has a unique SKU, a name, a category that exists, a unit price of zero or more, a tax rate and a stock quantity.", "evidence": "confirmed" },
    { "text": "The price including tax is always the unit price times one plus the tax rate, rounded to two decimals.", "evidence": "confirmed" },
    { "text": "Every update stamps the product with the time of the change in UTC, unless the update sets that time itself.", "evidence": "confirmed" },
    { "text": "The supplier is optional and refers to a supplier record, but the database does not check that the supplier exists.", "evidence": "inferred" },
    { "text": "Stock quantity is not prevented from going below zero, and the export shows no process that reduces stock when orders are placed.", "evidence": "inferred" }
  ]
