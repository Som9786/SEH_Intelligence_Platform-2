{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Localhost only: clients reach it through Insights.Gateway, which says who is signed in (the X-User header).
  "Urls": "http://localhost:5400",
  "Workspace": {
    // Where each user's schedules and widgets are kept, one JSON file per user. Relative to this project, or absolute.
    "DataPath": "App_Data",
    // How many days a shared insight's link works.
    "ShareDays": 30
  }
}
