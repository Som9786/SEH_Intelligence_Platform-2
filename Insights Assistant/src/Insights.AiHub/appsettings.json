{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5200",
  "OpenAI": {
    "ApiKey": "",
    // FOR NOW the cheapest model, at minimal reasoning: fast and cheap, less accurate. Empty uses FallbackModel.
    "Model": "gpt-5-nano",
    "FallbackModel": "gpt-5",
    "TimeoutSeconds": 150,
    // minimal, low, medium or high, for reasoning models (gpt-5, o-series). Lower is faster and cheaper.
    "ReasoningEffort": "minimal",
    // Questions are refused once today's OpenAI cost reaches this many US dollars. 0 = no limit.
    "DailyBudgetUsd": 5,
    // US dollars per million tokens, from https://openai.com/api/pricing. Used to count the cost of each call (GET /usage).
    "Prices": {
      "gpt-5": { "InputPerMillion": 1.25, "CachedInputPerMillion": 0.125, "OutputPerMillion": 10.00 },
      "gpt-5-mini": { "InputPerMillion": 0.25, "CachedInputPerMillion": 0.025, "OutputPerMillion": 2.00 },
      "gpt-5-nano": { "InputPerMillion": 0.05, "CachedInputPerMillion": 0.005, "OutputPerMillion": 0.40 },
      "gpt-4.1": { "InputPerMillion": 2.00, "CachedInputPerMillion": 0.50, "OutputPerMillion": 8.00 },
      "gpt-4.1-mini": { "InputPerMillion": 0.40, "CachedInputPerMillion": 0.10, "OutputPerMillion": 1.60 },
      "gpt-4o": { "InputPerMillion": 2.50, "CachedInputPerMillion": 1.25, "OutputPerMillion": 10.00 },
      "gpt-4o-mini": { "InputPerMillion": 0.15, "CachedInputPerMillion": 0.075, "OutputPerMillion": 0.60 }
    }
  },
  "Analytics": {
    "BaseUrl": "http://localhost:5100"
  },
  // POST /ask passes questions about the data to Analytics (above) and about the database's structure to DB Guide.
  "Routing": {
    "DbGuideBaseUrl": "http://localhost:5300",
    "TimeoutSeconds": 300
  },
  "Cache": {
    "Enabled": true,
    "MaxEntries": 500
  },
  "Answer": {
    "MaxResultChars": 50000
  },
  "DebugLog": {
    "Enabled": false,
    "MaxEntries": 1000,
    "WriteToFile": true,
    "FileDirectory": "logs",
    "RetainedFileDays": 7
  }
}
