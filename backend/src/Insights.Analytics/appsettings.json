{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5100",
  "Neo4j": {
    "Uri": "neo4j://127.0.0.1:7687",
    "User": "neo4j",
    "Password": "",
    "Database": "knowledge-model"
  },
  "PosBasket": {
    "Provider": "SqlServer",
    "Host": "localhost",
    "Port": 5432,
    "Database": "pos_basket",
    "User": "postgres",
    "Password": "",
    "SqlServer": {
      "ConnectionString": "Server=localhost;Database=pos_basket;Integrated Security=true;TrustServerCertificate=true",
      "Schema": "dbo"
    }
  },
  "Query": {
    "MaxRows": 1000,
    "TimeoutSeconds": 30
  },
  "AiHub": {
    "BaseUrl": "http://localhost:5200",
    "TimeoutSeconds": 180
  },
  "DebugLog": {
    "Enabled": false,
    "MaxEntries": 1000,
    "WriteToFile": true,
    "FileDirectory": "logs",
    "RetainedFileDays": 7
  }
}
