<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4f1bca2f-01c5-4ccf-9287-7d99827ff611</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.14" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AI Hub's request and response records, shared by every service that calls it. -->
    <Using Include="Insights.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Insights.Common\Insights.Common.csproj" />
    <ProjectReference Include="..\Insights.Contracts\Insights.Contracts.csproj" />
  </ItemGroup>

</Project>
