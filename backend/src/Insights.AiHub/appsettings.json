{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5200",
  // Which model service answers: "OpenAI" (the OpenAI section) or "Bedrock" (the Bedrock section). No restart needed.
  "Llm": {
    "Provider": "Bedrock"
  },
  "OpenAI": {
    "ApiKey": "",
    // FOR NOW the cheapest model, at minimal reasoning: fast and cheap, less accurate. Empty uses FallbackModel.
    "Model": "gpt-5-nano",
    "FallbackModel": "gpt-5",
    "TimeoutSeconds": 150,
    // minimal, low, medium or high, for reasoning models (gpt-5, o-series). Lower is faster and cheaper.
    "ReasoningEffort": "minimal",
    // Questions are refused once today's OpenAI cost reaches this many US dollars. 0 = no limit.
    "DailyBudgetUsd": 5,
    // US dollars per million tokens, from https://openai.com/api/pricing. Used to count the cost of each call (GET /usage).
    "Prices": {
      "gpt-5": { "InputPerMillion": 1.25, "CachedInputPerMillion": 0.125, "OutputPerMillion": 10.00 },
      "gpt-5-mini": { "InputPerMillion": 0.25, "CachedInputPerMillion": 0.025, "OutputPerMillion": 2.00 },
      "gpt-5-nano": { "InputPerMillion": 0.05, "CachedInputPerMillion": 0.005, "OutputPerMillion": 0.40 },
      "gpt-4.1": { "InputPerMillion": 2.00, "CachedInputPerMillion": 0.50, "OutputPerMillion": 8.00 },
      "gpt-4.1-mini": { "InputPerMillion": 0.40, "CachedInputPerMillion": 0.10, "OutputPerMillion": 1.60 },
      "gpt-4o": { "InputPerMillion": 2.50, "CachedInputPerMillion": 1.25, "OutputPerMillion": 10.00 },
      "gpt-4o-mini": { "InputPerMillion": 0.15, "CachedInputPerMillion": 0.075, "OutputPerMillion": 0.60 }
    }
  },
  // Amazon Bedrock (Converse API), used when Llm:Provider is "Bedrock". Set ApiKey (a Bedrock API key) with user-secrets,
  // or AccessKeyId + SecretAccessKey, or leave all empty to use AWS_BEARER_TOKEN_BEDROCK or the default AWS credentials.
  "Bedrock": {
    "Region": "eu-north-1",
    "ApiKey": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "SessionToken": "",
    // A model ID or inference profile ID enabled in Region (Bedrock console > Model catalog); it must support JSON schema
    // output. Empty uses FallbackModel. In eu-north-1 the organisation's AWS policy allows Claude Sonnet 4.6, Claude Opus 5
    // and Claude Haiku 4.5 (eu. inference profiles).
    "Model": "eu.anthropic.claude-sonnet-4-6",
    "FallbackModel": "eu.anthropic.claude-haiku-4-5-20251001-v1:0",
    "TimeoutSeconds": 150,
    "MaxTokens": 8192,
    // low, medium, high, xhigh or max. Not sent again to a model that rejects it (Claude Haiku 4.5). Empty leaves the model's default.
    "Effort": "low",
    "DailyBudgetUsd": 5,
    // US dollars per million tokens, from https://aws.amazon.com/bedrock/pricing. Matched by model ID, with or without the
    // inference profile's region prefix ("us."). Check these against the Bedrock price for your region.
    "Prices": {
      "anthropic.claude-sonnet-4-6": { "InputPerMillion": 3.00, "CachedInputPerMillion": 0.30, "CacheWriteInputPerMillion": 3.75, "OutputPerMillion": 15.00 },
      "anthropic.claude-opus-5": { "InputPerMillion": 5.00, "CachedInputPerMillion": 0.50, "CacheWriteInputPerMillion": 6.25, "OutputPerMillion": 25.00 },
      "anthropic.claude-sonnet-5": { "InputPerMillion": 2.00, "CachedInputPerMillion": 0.20, "CacheWriteInputPerMillion": 2.50, "OutputPerMillion": 10.00 },
      "anthropic.claude-haiku-4-5": { "InputPerMillion": 1.00, "CachedInputPerMillion": 0.10, "CacheWriteInputPerMillion": 1.25, "OutputPerMillion": 5.00 }
    }
  },
  "Cache": {
    "Enabled": true,
    "MaxEntries": 500
  },
  "Answer": {
    "MaxResultChars": 50000
  },
  "DebugLog": {
    "Enabled": false,
    "MaxEntries": 1000,
    "WriteToFile": true,
    "FileDirectory": "logs",
    "RetainedFileDays": 7
  }
}
