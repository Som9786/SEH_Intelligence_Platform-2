<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1c215393-3d8f-4841-8e47-a4562a718255</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Neo4j.Driver" Version="6.4.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <!-- The catalog's documentation is served from the published folder too (its JSON files are published by default). -->
  <ItemGroup>
    <None Update="catalog\**\*.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Insights.Common\Insights.Common.csproj" />
    <ProjectReference Include="..\Insights.Contracts\Insights.Contracts.csproj" />
  </ItemGroup>

</Project>
