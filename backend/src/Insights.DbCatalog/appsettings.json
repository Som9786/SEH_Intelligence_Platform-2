{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5300",
  "Neo4j": {
    "Uri": "neo4j://127.0.0.1:7687",
    "User": "neo4j",
    "Password": "",
    "Database": "db-guide"
  },
  "Catalog": {
    // The catalog folder, relative to this project: one folder per database, named after it, each with that database's
    // export (database.json, business-areas.json, relationships.json, tables/*.json and documentation/*.md) and its
    // db-catalog.json. A database is reloaded into Neo4j when a file in its folder changes.
    "Path": "catalog",
    // The database for requests that name none (the assistant's questions, and the routes without /databases/{name}).
    // Empty means the first folder by name.
    "DefaultDatabase": "SEH_Validation_Retail"
  },
  "AiHub": {
    "BaseUrl": "http://localhost:5200",
    "TimeoutSeconds": 180
  },
  "DebugLog": {
    "Enabled": false,
    "MaxEntries": 1000,
    "WriteToFile": true,
    "FileDirectory": "logs",
    "RetainedFileDays": 7
  }
}
