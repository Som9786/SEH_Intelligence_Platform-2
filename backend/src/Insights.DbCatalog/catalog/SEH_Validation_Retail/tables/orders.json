  ],
  "businessRules": [
    { "text": "Every order belongs to an existing customer, and a customer with orders cannot be deleted.", "evidence": "confirmed" },
    { "text": "Status is New, Paid, Shipped or Cancelled; a new order starts as New with a total of 0.", "evidence": "confirmed" },
    { "text": "The order total can never be negative.", "evidence": "confirmed" },
    { "text": "Deleting an order deletes its lines, and every insert, update and delete of an order is written to the audit log.", "evidence": "confirmed" },
    { "text": "The order total should equal the sum of its line totals, but the database does not calculate or check it.", "evidence": "inferred" },
    { "text": "The shipping address should belong to the ordering customer, which nothing enforces.", "evidence": "inferred" }
  ]
